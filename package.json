{
  "name": "booklet",
  "private": true,
  "description": "Turnos online para cualquier negocio. Tu agenda, siempre al día.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @booklet/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "10.14.0",
    "globals": "^17.14.0",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "type": "module"
}
