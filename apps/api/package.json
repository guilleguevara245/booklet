{
  "name": "@booklet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json -w --preserveWatchOutput\" \"node --env-file-if-exists=.env --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js",
    "db:seed": "node --env-file-if-exists=.env dist/database/seed.js"
  },
  "dependencies": {
    "@booklet/shared": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@nestjs/platform-socket.io": "12.5.0",
    "@nestjs/websockets": "12.5.0",
    "@socket.io/redis-adapter": "8.3.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "luxon": "^3.7.2",
    "nodemailer": "10.5.0",
    "postgres": "4.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "^1.16.22",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "concurrently": "^10.0.7",
    "drizzle-kit": "0.31.11",
    "smtp-server": "^3.21.4",
    "socket.io-client": "4.8.4",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
