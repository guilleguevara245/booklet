# Copiar a apps/api/.env y ajustar.
DATABASE_URL=postgres://booklet:booklet@localhost:5432/booklet
REDIS_URL=redis://localhost:6379
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Opcional: ID de cliente OAuth de Google para "Entrar con Google".
GOOGLE_CLIENT_ID=
# true solo si la API corre detrás de un proxy (Render, Fly, un balanceador).
TRUST_PROXY=false
# production activa la cookie de sesión con Secure (solo HTTPS).
NODE_ENV=development
# Mails. En desarrollo van a Mailpit (pnpm db:up): se ven en http://localhost:8025.
WEB_URL=http://localhost:5173
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Booklet <no-responder@booklet.local>
